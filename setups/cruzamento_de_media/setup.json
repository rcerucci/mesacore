{
 "nome": "cruzamento_de_media",
 "versao": "0.1.0",
 "linguagem": "typescript",
 "comando": [
  "bun",
  "run",
  "plugin.ts"
 ],
 "nota": "O plugin e os ITENS que ele publica (o template, RN-S3). Os VALORES nao moram aqui: moram na ficha de cada par (fichas/<PAR>/setup.json), e por isso dois pares podem correr o mesmo setup com relogios diferentes (a `janela` e' um item do template, com omissao 1h).",
 "parametros": {
  "rapida": 5,
  "lenta": 20
 },
 "template": {
  "janela": {
   "tipo": "texto",
   "omissao": "1h",
   "de": "venue",
   "nota": "o relogio do par"
  },
  "parametros.rapida": {
   "tipo": "inteiro",
   "omissao": 5
  },
  "parametros.lenta": {
   "tipo": "inteiro",
   "omissao": 20
  },
  "politica_de_execucao": {
   "tipo": "escolha",
   "opcoes": [
    "mercado",
    "passiva"
   ],
   "omissao": "mercado"
  },
  "parcial": {
   "tipo": "escolha",
   "opcoes": [
    "o_que_der"
   ],
   "omissao": "o_que_der"
  },
  "desvio_maximo": {
   "tipo": "texto",
   "omissao": "0.5"
  },
  "prazo_da_passiva_ms": {
   "tipo": "inteiro",
   "omissao": 3000
  },
  "destino_do_resto": {
   "tipo": "escolha",
   "opcoes": [
    "agressivo",
    "cancelar"
   ],
   "omissao": "agressivo"
  }
 }
}