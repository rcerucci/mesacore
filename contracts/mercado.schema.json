{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mesacore.local/contracts/mercado.schema.json",
  "title": "Objecto de mercado",
  "description": "O objecto de factos que a mesa entrega ao setup E ao humano (RN-D1, RN-D5). So factos. Ausencia e declarada pela ausencia da chave (RN-D4) — nunca por um valor neutro.",
  "type": "object",
  "additionalProperties": false,
  "required": ["instrumento", "tempo_do_venue_ms", "idade_do_dado_ms", "estado", "equity", "ordens_abertas"],
  "properties": {
    "instrumento": {"$ref": "_defs/forma.schema.json#/$defs/instrumento"},
    "tempo_do_venue_ms": {"$ref": "_defs/forma.schema.json#/$defs/instante_ms"},
    "idade_do_dado_ms": {"$ref": "_defs/forma.schema.json#/$defs/duracao_ms"},
    "estado": {"enum": ["aberto", "fechado"], "description": "Mercado fechado e ESTADO, nao erro (RN-D8)."},
    "bid": {"$ref": "_defs/forma.schema.json#/$defs/decimal_positivo"},
    "ask": {"$ref": "_defs/forma.schema.json#/$defs/decimal_positivo"},
    "ultimo": {"$ref": "_defs/forma.schema.json#/$defs/decimal_positivo"},
    "livro": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lados", "profundidade"],
      "properties": {
        "lados": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["preco", "tamanho"],
            "properties": {
              "preco": {"$ref": "_defs/forma.schema.json#/$defs/decimal_positivo"},
              "tamanho": {"$ref": "_defs/forma.schema.json#/$defs/decimal_positivo"}
            }
          }
        },
        "profundidade": {"type": "integer", "minimum": 1, "description": "Profundidade DECLARADA: o setup sabe o que nao ve."}
      }
    },
    "ordens_abertas": {
      "type": "array",
      "description": "AS ORDENS VIVAS NO VENUE — o que existe na conta e nao e' posicao: o que ficou pendurado, o que ficou por cancelar, o que outro dedo pos. OBRIGATORIA, e LISTA VAZIA NAO E' O MESMO QUE AUSENTE: `[]` diz 'perguntei, e nao ha' nenhuma'; ausente seria 'nao perguntei'. Quem nao conseguiu perguntar NAO PRODUZ leitura (recusa nomeada) — uma lista vazia inventada aqui faria a mesa achar que a conta esta' limpa quando nao esta'.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instrumento", "ordem", "lado", "preco", "unidades"],
        "properties": {
          "instrumento": {"$ref": "_defs/forma.schema.json#/$defs/instrumento"},
          "ordem": {"type": "string", "minLength": 1, "description": "O identificador da ordem NO VENUE (`oid`). E' por ele que a mesa e o humano falam da MESMA ordem."},
          "lado": {"enum": ["buy", "sell"]},
          "preco": {"$ref": "_defs/forma.schema.json#/$defs/decimal_positivo"},
          "unidades": {"$ref": "_defs/forma.schema.json#/$defs/decimal_positivo"},
          "marca_de_posse": {"$ref": "_defs/forma.schema.json#/$defs/marca_de_posse_do_venue"}
        }
      }
    },
    "posicao": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lado", "unidades", "preco_medio"],
      "properties": {
        "lado": {"enum": ["buy", "sell"]},
        "unidades": {"$ref": "_defs/forma.schema.json#/$defs/decimal_positivo"},
        "preco_medio": {"$ref": "_defs/forma.schema.json#/$defs/decimal_positivo"},
        "marca_de_posse": {"$ref": "_defs/forma.schema.json#/$defs/marca_de_posse"}
      },
      "description": "Ausente = sem posicao. A posse le-se do VENUE, pela marca (RN-T16.1)."
    },
    "equity": {"$ref": "_defs/forma.schema.json#/$defs/decimal", "description": "Saldo com nao realizado: e sobre isto que o circuit breaker mede (RN-M3)."},
    "funding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taxa", "instante_ms"],
      "properties": {
        "taxa": {"$ref": "_defs/forma.schema.json#/$defs/decimal"},
        "instante_ms": {"$ref": "_defs/forma.schema.json#/$defs/instante_ms"}
      }
    }
  }
}
