{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mesacore.local/contracts/historico.schema.json",
  "title": "Historico do venue",
  "description": "O trilho do dinheiro, como o venue o conta (RN-C11, RN-D6). Taxas e funding em campos PROPRIOS: somar e do venue, nunca da mesa. Nao ha campo de resultado por execucao — recalculado pela mesa seria a mesa a reescrever a conta da corretora.",
  "type": "object",
  "additionalProperties": false,
  "required": ["instrumento", "moeda", "instante_ms", "resultado_realizado", "execucoes"],
  "properties": {
    "instrumento": {"$ref": "_defs/forma.schema.json#/$defs/instrumento"},
    "moeda": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "instante_ms": {"$ref": "_defs/forma.schema.json#/$defs/instante_ms"},
    "resultado_realizado": {"$ref": "_defs/forma.schema.json#/$defs/decimal", "description": "Como o venue o reporta. A mesa mostra, nao reconstroi."},
    "execucoes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["referencia_do_cliente", "marca_de_posse", "instante_ms", "lado", "quantidade", "preco", "taxa"],
        "properties": {
          "referencia_do_cliente": {"$ref": "_defs/forma.schema.json#/$defs/correlacao"},
          "marca_de_posse": {"$ref": "_defs/forma.schema.json#/$defs/marca_de_posse"},
          "instante_ms": {"$ref": "_defs/forma.schema.json#/$defs/instante_ms"},
          "lado": {"enum": ["buy", "sell"]},
          "quantidade": {"$ref": "_defs/forma.schema.json#/$defs/decimal_positivo"},
          "preco": {"$ref": "_defs/forma.schema.json#/$defs/decimal_positivo"},
          "taxa": {"$ref": "_defs/forma.schema.json#/$defs/decimal_nao_negativo", "description": "Custo da execucao, como o venue o cobra."},
          "funding": {"$ref": "_defs/forma.schema.json#/$defs/decimal", "description": "Funding da execucao, em campo PROPRIO. Ausente quando o venue nao o reporta por execucao."}
        }
      }
    }
  }
}
